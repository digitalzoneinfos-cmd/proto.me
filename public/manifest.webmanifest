{
  "id": "/protoflow",
  "name": "ProtoFlow — Store reports",
  "short_name": "ProtoFlow",
  "description": "Income, expenses, receipts and staff alerts for store managers and owners — by PROTO.ME",
  "start_url": "./#/login",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#050817",
  "theme_color": "#050817",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "icon-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "icon-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "icon-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Today's entry", "short_name": "Entry", "url": "./#/entries", "icons": [{ "src": "icon-96.png", "sizes": "96x96" }] },
    { "name": "Daily report", "short_name": "Daily", "url": "./#/daily", "icons": [{ "src": "icon-96.png", "sizes": "96x96" }] },
    { "name": "Monthly report", "short_name": "Monthly", "url": "./#/monthly", "icons": [{ "src": "icon-96.png", "sizes": "96x96" }] },
    { "name": "Expenses", "short_name": "Expenses", "url": "./#/expenses", "icons": [{ "src": "icon-96.png", "sizes": "96x96" }] }
  ]
}
